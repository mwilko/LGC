# This file is used to set environment variables for the React application.

# EmailJS configuration for sending emails from the application
REACT_APP_EMAILJS_PUBLIC_KEY=system.env.REACT_APP_EMAILJS_PUBLIC_KEY
REACT_APP_EMAILJS_SERVICE_ID=system.env.REACT_APP_EMAILJS_SERVICE_ID
REACT_APP_EMAILJS_TEMPLATE_ID=system.env.REACT_APP_EMAILJS_TEMPLATE_ID